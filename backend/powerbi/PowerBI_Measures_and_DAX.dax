// ==============================================================================
// 📊 Power BI DAX Measures for Civic Issue Reporting and Resolution System
// Copy and paste these measures directly into your Power BI Desktop Model
// ==============================================================================

// 1. Total Complaints Count
Total Complaints = 
COUNTROWS('Complaints')

// 2. Total Resolved Complaints
Total Resolved = 
CALCULATE(
    COUNTROWS('Complaints'),
    'Complaints'[Status] = "Resolved"
)

// 3. Total Pending Complaints
Total Pending = 
CALCULATE(
    COUNTROWS('Complaints'),
    'Complaints'[Status] = "Pending"
)

// 4. In Progress Complaints
Total In Progress = 
CALCULATE(
    COUNTROWS('Complaints'),
    'Complaints'[Status] = "In Progress"
)

// 5. Total Assigned Complaints
Total Assigned = 
CALCULATE(
    COUNTROWS('Complaints'),
    'Complaints'[Status] = "Assigned"
)

// 6. Resolution Rate (%)
Resolution Rate % = 
DIVIDE(
    [Total Resolved],
    [Total Complaints],
    0
) * 100

// 7. Active Backlog (Unresolved Issues)
Active Backlog = 
[Total Complaints] - [Total Resolved]

// 8. Backlog Ratio (%)
Backlog Ratio % = 
DIVIDE(
    [Active Backlog],
    [Total Complaints],
    0
) * 100

// 9. High Severity Complaints Count
High Severity Count = 
CALCULATE(
    COUNTROWS('Complaints'),
    'Complaints'[Severity] = "High"
)

// 10. High Severity Share (%)
High Severity Share % = 
DIVIDE(
    [High Severity Count],
    [Total Complaints],
    0
) * 100

// 11. Average Resolution Time (Hours)
Average Resolution Hours = 
AVERAGEX(
    FILTER('Complaints', 'Complaints'[Status] = "Resolved" && NOT(ISBLANK('Complaints'[ResolutionHours]))),
    'Complaints'[ResolutionHours]
)

// 12. SLA Compliance Rate (% resolved within 48 hours)
SLA Compliance Rate % = 
VAR ResolvedWithinSLA = 
    CALCULATE(
        COUNTROWS('Complaints'),
        'Complaints'[Status] = "Resolved",
        'Complaints'[ResolutionHours] <= 48
    )
RETURN
    DIVIDE(ResolvedWithinSLA, [Total Resolved], 0) * 100

// 13. Average Priority Score
Average Priority Score = 
AVERAGE('Complaints'[PriorityScore])

// 14. Duplicate Complaints Flagged Count
Duplicate Complaints Count = 
CALCULATE(
    COUNTROWS('Complaints'),
    'Complaints'[IsDuplicate] = 1
)

// 15. Duplicate Reduction Efficiency (%)
Duplicate Reduction Rate % = 
DIVIDE(
    [Duplicate Complaints Count],
    [Total Complaints],
    0
) * 100

// 16. Severity Severity Weighted Index
Civic Hazard Index = 
SUMX(
    'Complaints',
    'Complaints'[SeverityWeight] * 'Complaints'[PriorityScore]
) / 100
